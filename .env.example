NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Production only. The application then loads database-url,
# app-jwt-secret, and gemini-api-key from Azure Key Vault.
# KEY_VAULT_URL=https://nhatminh-backend-kv-2026.vault.azure.net/
# For an external VPS, DefaultAzureCredential can use a restricted service
# principal supplied through protected host configuration (never commit it):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_DATABASE=au_merchhub
MYSQL_USER=merchhub
MYSQL_PASSWORD=replace-with-application-password

DATABASE_URL=mysql://merchhub:replace-with-application-password@127.0.0.1:3308/au_merchhub
SHADOW_DATABASE_URL=mysql://merchhub:replace-with-application-password@127.0.0.1:3308/au_merchhub_shadow

# Microsoft Entra ID application registration
# Portal: https://entra.microsoft.com
# Path: Entra ID > App registrations > your AU-MerchHub app > Overview
# Copy "Directory (tenant) ID" from the Essentials section.
MICROSOFT_TENANT_ID=
# Copy "Application (client) ID" from the Essentials section.
MICROSOFT_CLIENT_ID=
# Enter the university email suffix after @, without the @ symbol.
# Example: for student@university.edu, enter university.edu
MICROSOFT_ALLOWED_EMAIL_DOMAIN=

# Gemini API integration for product-description generation. Keep the real
# API key only in the local .env file; production will load it from Key Vault.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Generate a random value containing at least 32 characters. This value does
# not come from Microsoft. Never commit the real value stored in .env.
# PowerShell/terminal command:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
APP_JWT_SECRET=
# Stable identifiers used when issuing and verifying AU-MerchHub JWTs.
# Keep these defaults unless the deployment configuration requires otherwise.
APP_JWT_ISSUER=au-merchhub
APP_JWT_AUDIENCE=au-merchhub-api
